<?php
// API recipe hint, rendered by Snowcrawl from the recipe's data: a draft to review, never run by Snowcrawl.
//
// $params holds each parameter's value as read from the page by its binder:
{% for name, binder in recipe.params_from_url.items() %}
//   {{ name|php_comment }}: {{ binder|php_comment }}
{% endfor %}
// path:<i> is segment i (from 0) of the page URL's path after its leading "/"; query:<name> is the first non-empty
// value of that query parameter; regex:<pattern> is the pattern's group, searched in the page URL's path (PCRE, /u);
// each percent-decoded. jsonld:<path> and js_state:<path> are the one scalar the JSONPath selects in the page's JSON-LD
// or JavaScript state documents, a list of them in page order.
{% if recipe.requires_page_fetch %}
// This recipe reads the page's JSON documents: fetch the page's HTML first.
{% endif %}
//
// The response is JSON. Each field's value is at a JSONPath (RFC 9535); parts joined by "+" are read one by one and
// joined with a space:
{% for name, path in recipe.map.items() %}
//   {{ name|php_comment }}: {{ path|php_comment }}
{% endfor %}
{% set pagination = recipe.pagination %}
{% if pagination %}
{% if pagination.kind == "param" %}
// Pagination: set {{ pagination.where|php_comment }} value {{ pagination["name"]|php_comment }} to {{ pagination.start|php_int }}, {{ (pagination.start + pagination.step)|php_int }}, {{ (pagination.start + 2 * pagination.step)|php_int }}, ... until {{ pagination.rows|php_comment }} selects nothing.
{% elif pagination.kind == "cursor" %}
// Pagination: set {{ pagination.where|php_comment }} value {{ pagination["name"]|php_comment }} to the value the previous response holds at {{ pagination.cursor|php_comment }}, until it holds none or {{ pagination.rows|php_comment }} selects nothing.
{% elif pagination.kind == "next_url" %}
// Pagination: request the URL the previous response holds at {{ pagination["next"]|php_comment }} (RFC 3986 resolution, same origin), until it holds none or {{ pagination.rows|php_comment }} selects nothing.
{% elif pagination.kind == "none" %}
// Pagination: none; the one response holds every row {{ pagination.rows|php_comment }} selects.
{% else %}
// Pagination: request the target of the previous response's Link header with rel="next" (RFC 8288, same origin), until there is none or {{ pagination.rows|php_comment }} selects nothing.
{% endif %}
{% endif %}

{% if context_headers %}
// $context holds the values of the headers the recipe takes from the caller's request context, by name; the recipe
// stores the names alone.
{% endif %}
function api_recipe_request(string $page_url, array $params, array $context = []): array
{
    $path = [];
    $query = [];
    $json = [];
    foreach ($params as $name => $value) {
        // Percent-encoded as RFC 3986 allows in a path segment and a query value.
        $path['{' . $name . '}'] = strtr(rawurlencode($value), [{% for code, char in path_decode.items() %}{{ code|php_literal }} => {{ char|php_literal }}{% if not loop.last %}, {% endif %}{% endfor %}]);
        $query['{' . $name . '}'] = strtr(rawurlencode($value), [{% for code, char in query_decode.items() %}{{ code|php_literal }} => {{ char|php_literal }}{% if not loop.last %}, {% endif %}{% endfor %}]);
        // JSON string content (RFC 8259 §7).
        $json['{' . $name . '}'] = substr(json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_LINE_TERMINATORS | JSON_THROW_ON_ERROR), 1, -1);
    }
    return [
        'method' => {{ recipe.method|php_literal }},
{% if query is none %}
        'url' => strtr({{ path|php_literal }}, $path),
{% else %}
        'url' => strtr({{ path|php_literal }}, $path) . '?' . strtr({{ query|php_literal }}, $query),
{% endif %}
        'headers' => [
{% for line in headers %}
{% if page_url in line %}
            str_replace({{ page_url|php_literal }}, $page_url, {{ line|php_literal }}),
{% else %}
            {{ line|php_literal }},
{% endif %}
{% endfor %}
{% for name in context_headers %}
            {{ (name ~ ": ")|php_literal }} . $context[{{ name|php_literal }}],
{% endfor %}
{% if no_content_type %}
            // curl sends a form content type with a POST; an empty value sends none, as Snowcrawl does.
            'Content-Type:',
{% endif %}
        ],
{% if recipe.body %}
        'body' => strtr({{ recipe.body.template|php_literal }}, $json),
{% else %}
        'body' => null,
{% endif %}
    ];
}

// The decoded JSON response, or null when the request fails, the status is not 2xx or the body is not JSON.
function api_recipe_fetch(string $page_url, array $params, array $context = []): mixed
{
    $request = api_recipe_request($page_url, $params, $context);
    $curl = curl_init($request['url']);
    curl_setopt_array($curl, [
        CURLOPT_HTTPHEADER => $request['headers'],
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_MAXREDIRS => {{ max_redirects|php_int }},
    ]);
    if ($request['method'] === 'POST') {
        // A POST through CURLOPT_POSTFIELDS: curl then follows a 301, 302 or 303 with a GET (RFC 9110 §15.4).
        curl_setopt($curl, CURLOPT_POSTFIELDS, $request['body'] ?? '');
    }
    $text = curl_exec($curl);
    $status = curl_getinfo($curl, CURLINFO_RESPONSE_CODE);
    if ($text === false || $status < 200 || $status > 299) {
        return null;
    }
    return json_decode($text, true);
}
